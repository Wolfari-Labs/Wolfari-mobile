{
  "expo": {
    "name": "Wolfari-mobile",
    "slug": "wolfari-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wolfari-app-icon.png",
    "scheme": "wolfarimobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/wolfari-app-icon.png",
      "bundleIdentifier": "com.tan1custeam.wolfarimobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DDF7EF",
        "foregroundImage": "./assets/images/wolfari-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tanthanh_67.Wolfarimobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/wolfari-app-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": { "web": false }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#073B49",
          "image": "./assets/figma/mascot.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#073B49",
            "image": "./assets/figma/mascot.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Wolfari chọn ảnh đại diện, ảnh bìa hoặc chứng từ thử nghiệm từ thư viện của bạn.",
          "cameraPermission": "Cho phép Wolfari dùng camera để quét mã QR chuyển khoản.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Wolfari dùng camera để quét mã QR chuyển khoản.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa192112-7eac-4ed2-9caa-45089c70faec"
      }
    },
    "owner": "tan1cus-team"
  }
}
