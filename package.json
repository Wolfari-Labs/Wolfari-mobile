{
  "name": "wolfari-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "node tests/ui/auth-flow.mjs",
    "test:ui:trips": "node tests/ui/trip-flow.mjs",
    "test:ui:order": "node tests/ui/order-flow.mjs",
    "test:ui:features": "node tests/ui/backend-features-flow.mjs",
    "test:ui:parity": "node tests/ui/mobile-parity-flow.mjs",
    "test:ui:backend": "node --env-file-if-exists=.env.backend-test.local tests/ui/backend-flow.mjs",
    "test:backend": "node --env-file-if-exists=.env.backend-test.local --experimental-strip-types scripts/check-backend.mjs",
    "test:ui:finance": "node tests/ui/finance-price-watch-flow.mjs",
    "test:backend:finance": "node --experimental-strip-types scripts/check-finance-price-watch.mjs"
  },
  "private": true
}
