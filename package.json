  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "node tests/ui/auth-flow.mjs",
    "test:ui:trips": "node tests/ui/trip-flow.mjs",
    "test:ui:order": "node tests/ui/order-flow.mjs",
    "test:ui:features": "node tests/ui/backend-features-flow.mjs",
    "test:ui:parity": "node tests/ui/mobile-parity-flow.mjs",
    "test:ui:backend": "node --env-file-if-exists=.env.backend-test.local tests/ui/backend-flow.mjs",
    "test:backend": "node --env-file-if-exists=.env.backend-test.local --experimental-strip-types scripts/check-backend.mjs"
  },
  "private": true
}
