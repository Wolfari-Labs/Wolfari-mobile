# Expo Go over Wi-Fi: leave empty to use the Expo host IP and the LAN bridge on :3001.
# Terminal 1: npm run dev:gateway
# Terminal 2: npm run start:go (scan its QR code with Expo Go)
EXPO_PUBLIC_API_URL=

# Enable only on a separate test build to expose MoMo Test and the simulated fund tools.
EXPO_PUBLIC_PAYMENT_SANDBOX=false

# A deployed API or an explicitly configured Gateway reachable from your phone:
# EXPO_PUBLIC_API_URL=https://your-gateway.example/api/v1

# Dev only: Mailpit web UI opened from the verify-email screen (defaults to <Gateway host>:8025).
# EXPO_PUBLIC_MAILPIT_URL=http://192.168.1.10:8025

# Google Maps SDK for Android (standalone builds). Restrict to the Android package and signing SHA-1.
GOOGLE_MAPS_API_KEY=
