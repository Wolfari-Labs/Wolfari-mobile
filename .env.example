# Expo Go over Wi-Fi: leave empty to use the Expo host IP and the LAN bridge on :3001.
# Terminal 1: npm run dev:gateway
# Terminal 2: npm run start:go (scan its QR code with Expo Go)
EXPO_PUBLIC_API_URL=

# A deployed API or an explicitly configured Gateway reachable from your phone:
# EXPO_PUBLIC_API_URL=https://your-gateway.example/api/v1
